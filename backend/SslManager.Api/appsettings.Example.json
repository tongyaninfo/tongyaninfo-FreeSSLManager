{
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/ssl-manager.db"
  },
  "Storage": {
    "KeyDirectory": "App_Data/keys"
  },
  "Worker": {
    "PollSeconds": 15
  },
  "Mail": {
    "AllowedPrivateHosts": []
  },
  "Mcp": {
    "OAuth": {
      "Issuer": "https://freessl.example.com",
      "CertificatePath": "App_Data/mcp-oauth.pfx",
      "CertificatePassword": "CHANGE_ME",
      "CertificatePemPath": "",
      "PrivateKeyPemPath": ""
    },
    "TrustedProxyAddresses": [],
    "TrustedProxyNetworks": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
