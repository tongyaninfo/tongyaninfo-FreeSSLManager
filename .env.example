# 通研免费 SSL 管理系统 · 环境变量示例
# 复制为 .env（或直接在启动环境里设置）后按需修改；不要提交真实值。
# 后端启动时读取 ASPNETCORE_* 前缀的宿主配置；业务配置仍在 appsettings.json / appsettings.Example.json。
# 前端开发代理读取 SSL_API_PROXY。

# ---- 后端宿主 ----
# 监听地址；生产部署通常由反向代理终止 TLS，再转发到本机回环端口。
ASPNETCORE_URLS=http://127.0.0.1:5000
# 运行环境：Development / Production
ASPNETCORE_ENVIRONMENT=Development

# ---- 业务配置覆盖（与 appsettings.json 的键同名时优先） ----
# SQLite 数据库路径；默认相对后端内容根目录。
#ConnectionStrings__Default=Data Source=App_Data/ssl-manager.db
# DataProtection 密钥目录；与数据库必须成套备份。
#Storage__KeyDirectory=App_Data/keys
# 后台任务轮询间隔（秒）。
#Worker__PollSeconds=15
# 允许主机名，生产环境改为实际域名。
#AllowedHosts=localhost;127.0.0.1

# ---- MCP（默认关闭；配置有效 RSA 证书与 HTTPS issuer 后才启用 OAuth） ----
#Mcp__OAuth__Issuer=https://freessl.example.com
#Mcp__OAuth__CertificatePath=App_Data/mcp-oauth.pfx
#Mcp__OAuth__CertificatePassword=CHANGE_ME
# 也可使用 PEM 证书 + 私钥，二者必须同时配置。
#Mcp__OAuth__CertificatePemPath=App_Data/mcp-oauth.crt
#Mcp__OAuth__PrivateKeyPemPath=App_Data/mcp-oauth.key
# 位于反向代理后且需要真实来源地址时，配置可信代理。
#Mcp__TrustedProxyAddresses__0=127.0.0.1
#Mcp__TrustedProxyNetworks__0=10.0.0.0/8

# ---- 邮件（SMTP 连接参数通过界面录入并加密保存；此处仅放行内网 SMTP 主机名） ----
#Mail__AllowedPrivateHosts__0=smtp.internal.example.com

# ---- 前端开发代理 ----
# 后端地址；默认 https://localhost:5001。
#SSL_API_PROXY=https://localhost:5001
